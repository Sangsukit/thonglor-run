# Public address of the site (used in email links and payment redirects)
BASE_URL=https://run.example.com
PORT=3000
DATABASE_URL=postgres://tgr:tgr@localhost:5432/tgr
# Set to true for hosted Postgres that requires SSL (most managed providers)
DATABASE_SSL=false

# Organizer desk at /admin
ADMIN_PASSWORD=change-me-to-something-long
# Any long random string: openssl rand -hex 32
SESSION_SECRET=

# Automatic payments through Omise (PromptPay QR + cards). Leave empty to use manual PromptPay below.
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=

# Manual PromptPay (only used when Omise keys are empty): mobile number or 13-digit tax ID
PROMPTPAY_ID=
PROMPTPAY_NAME=

# Email (confirmation, bib number, ticket links). Example: smtps://user:pass@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=Thonglor Charity Run <no-reply@run.example.com>

# Optional
CAPACITY=3000
HOLD_HOURS=24
REGISTRATION_CLOSES_AT=

# Shirt design shown on the site: 1 = maroon 10K / white 5K, 2 = orange 10K / white 5K (deck options)
SHIRT_DESIGN=1
